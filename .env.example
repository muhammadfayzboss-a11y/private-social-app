# Copy to .env and adjust before first launch:  cp .env.example .env
NODE_ENV=development
PORT=4173

# Public origin of the app. Use your real https:// URL in production (enables Secure cookies + HSTS).
APP_ORIGIN=http://localhost:4173

# Set to true ONLY when running behind a trusted reverse proxy (Fly, Render, Caddy, nginx).
# It lets rate limiting see each member's real IP instead of the proxy's shared address.
TRUST_PROXY=false

# Storage locations (keep both on a persistent disk/volume in production)
DATABASE_PATH=./data/circle.db
UPLOAD_DIR=./data/uploads
STICKER_DIR=./stickers

# Sessions and uploads
SESSION_DAYS=30
MAX_UPLOAD_MB=25

# REQUIRED: 32+ random characters. Generate with: openssl rand -hex 32
APP_SECRET=replace-with-at-least-32-random-characters

# REQUIRED: one-time code used to create the very first admin account, then never again.
SETUP_CODE=replace-with-a-private-one-time-setup-code

# OPTIONAL: enables real Web Push notifications. Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
